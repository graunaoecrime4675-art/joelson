<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Conversor de Temperatura</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
<div class="container">
    <h2>Conversor de Temperatura</h2>

    <label>Digite a temperatura:</label>
    <input type="number" id="temp">

    <br><br>

    <label>Escolha a conversão:</label>
    <select id="tipo">
        <option value="cf">Celsius → Fahrenheit</option>
        <option value="fc">Fahrenheit → Celsius</option>
        <option value="ck">Celsius → Kelvin</option>
        <option value="kc">Kelvin → Celsius</option>
    </select>

    <br><br>

    <button onclick="converter()">Converter</button>

    <h3 id="resultado"></h3>

    <script>
        function converter() {
            let temp = parseFloat(document.getElementById("temp").value);
            let tipo = document.getElementById("tipo").value;
            let resultado;

            if (tipo === "cf") {
                resultado = (temp * 9/5) + 32;
            } else if (tipo === "fc") {
                resultado = (temp - 32) * 5/9;
            } else if (tipo === "ck") {
                resultado = temp + 273.15;
            } else if (tipo === "kc") {
                resultado = temp - 273.15;
            }

            document.getElementById("resultado").innerText = "Resultado: " + resultado.toFixed(2);
        }
    </script>
</div>
</body>
</html>
